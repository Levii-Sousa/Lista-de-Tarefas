generator client {
  provider = "prisma-client-js"
  output   = "./src/app/lib/prismaClient" // Diretório onde o Prisma Client será gerado
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Task {
  id        Int     @id @default(autoincrement())
  title     String
  completed Boolean @default(false)
}
